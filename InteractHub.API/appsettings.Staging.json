{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=<your-rds-endpoint>.rds.amazonaws.com;Database=InteractionHub;User Id=<your-username>;Password=<your-password>;TrustServerCertificate=True;Encrypt=True;"
  },
  "Jwt": {
    "Key": "your-super-secret-key-at-least-32-characters",
    "Issuer": "InteractHub",
    "Audience": "InteractHubUsers",
    "ExpirationInDays": 7
  }
}
